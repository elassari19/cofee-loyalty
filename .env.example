# Copy this file to `.env` and fill in real values.
# Never commit `.env` — only `.env.example` (names + non-secret placeholders) is committed.

# --- Application ---
# Canonical base URL of the app (no trailing slash)
APP_URL=http://localhost:3000
# Development / production runtime mode
NODE_ENV=development

# --- PostgreSQL (system of record) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Managed/hosted databases: append ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loyalty_dev

# --- Redis (cache, rate limiting, async jobs ONLY — never the system of record) ---
# Format: redis://:PASSWORD@HOST:PORT/DB
REDIS_URL=redis://localhost:6379

# --- Authentication (Better Auth) ---
# Generate a value with: pnpm dlx auth@latest secret
BETTER_AUTH_SECRET=replace-with-generated-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Rate limiting (login, registration, password reset, QR lookup, redemption codes) ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
