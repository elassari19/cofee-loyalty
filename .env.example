# Copy this file to `.env` and fill in real values.
# Never commit `.env` — only `.env.example` (names + non-secret placeholders) is committed.

# --- Application ---
# Canonical base URL of the app (no trailing slash)
APP_URL=http://localhost:3000
# Development / production runtime mode
NODE_ENV=development

# --- PostgreSQL (system of record) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Managed/hosted databases: append ?sslmode=require
# Port 5433 matches the default in docker-compose.yml (`pnpm services:up`),
# which avoids clashing with a system-wide PostgreSQL on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/loyalty_dev

# --- Redis (cache, rate limiting, async jobs ONLY — never the system of record) ---
# Format: redis://:PASSWORD@HOST:PORT/DB
# Port 6380 matches the default in docker-compose.yml (`pnpm services:up`).
REDIS_URL=redis://localhost:6380

# --- Authentication (Better Auth) ---
# Required, minimum 32 characters — the server refuses to start while this is
# still the placeholder below. Generate a value with: pnpm dlx auth@latest secret
BETTER_AUTH_SECRET=replace-with-generated-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Logging ---
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Rate limiting (login, registration, password reset, QR lookup, redemption codes) ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
