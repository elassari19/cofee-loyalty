# Copy this file to `.env` and fill in real values.
# Never commit `.env` — only `.env.example` (names + non-secret placeholders) is committed.

# --- Application ---
# Canonical base URL of the app (no trailing slash)
APP_URL=http://localhost:3000
# Development / production runtime mode
NODE_ENV=development

# --- PostgreSQL (system of record) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Managed/hosted databases: append ?sslmode=require
# Port 5433 matches the default in docker-compose.yml (`pnpm services:up`),
# which avoids clashing with a system-wide PostgreSQL on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/loyalty_dev

# --- Redis (cache, rate limiting, async jobs ONLY — never the system of record) ---
# Format: redis://:PASSWORD@HOST:PORT/DB
# Port 6380 matches the default in docker-compose.yml (`pnpm services:up`).
REDIS_URL=redis://localhost:6380

# --- Authentication (Better Auth) ---
# Required, minimum 32 characters — the server refuses to start while this is
# still the placeholder below. Generate a value with: pnpm dlx auth@latest secret
BETTER_AUTH_SECRET=replace-with-generated-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Logging ---
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Rate limiting (login, registration, password reset, QR lookup, redemption codes) ---
# All values are optional — the defaults shown below are applied when omitted.
# Counters live in Redis and fall back to per-process memory when Redis is down.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600
RATE_LIMIT_TOKEN_RESOLVE_MAX=30
RATE_LIMIT_TOKEN_RESOLVE_WINDOW_SECONDS=60
RATE_LIMIT_REDEMPTION_MAX=10
RATE_LIMIT_REDEMPTION_WINDOW_SECONDS=60

# --- Redemption codes (checklist §9) ---
# How long a customer-issued redemption code stays usable, in minutes. The
# effective deadline is the earlier of this window and the reward's own expiry.
REDEMPTION_CODE_TTL_MINUTES=120

# --- Email verification ---
# true  = sign-in is blocked until the address is verified (enable in production
#         once an email provider is configured through src/integrations/email).
# false = verification links still work, but sign-in is not blocked (local dev).
AUTH_REQUIRE_EMAIL_VERIFICATION=false
